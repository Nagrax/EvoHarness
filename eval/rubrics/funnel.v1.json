    {"code": "CNT", "group": "serial", "sub_items": ["source", "json", "table", "paragraph", "lead", "generic"]},
    {"code": "RED", "group": "parallel", "sub_items": ["safety"]}
  ],
  "sub_items": [
    "nonempty",
    "unfounded_claims",
    "uncertainty",
    "instruction_alignment",
    "decision_rule",
    "source",
    "json",
    "table",
    "paragraph",
    "lead",
    "generic",
    "safety"
  ]
}
