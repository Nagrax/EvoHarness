{
  "version": "funnel.v1",
  "description": "分层漏斗 rubric：CTX/BOUND/EXEC/CNT 串行短路，RED 并行独立。",
  "serial_layers": ["CTX", "BOUND", "EXEC", "CNT"],
  "parallel_layers": ["RED"],
  "layers": [
    {"code": "CTX", "group": "serial", "sub_items": ["nonempty"]},
