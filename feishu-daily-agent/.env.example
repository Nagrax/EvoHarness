# ============ 飞书日报与经验回复 Agent 配置 ============
# 复制为 .env 后填写。没有飞书凭证时保持默认即可离线运行（offline 模式，
# 只出本地日报/黄金回放，不连飞书）；配好后按下面的开关逐级放开。

# ---- 飞书应用（从 open.feishu.cn 开发者后台 → 凭证与基础信息复制）----
FEISHU_APP_ID=offline-app
FEISHU_APP_SECRET=offline-secret
# owner 的 open_id（ou_ 开头）。获取方式见 FEISHU_APP_SETUP.md 第 5 步
FEISHU_OWNER_OPEN_ID=ou_owner
# 机器人自己的 open_id（可选，运行日志里可看到）
FEISHU_BOT_OPEN_ID=

# ---- 部署模式（从安全到放开）----
#   offline          只跑本地流水线，不连飞书
#   readonly_shadow  连飞书：收消息、给 owner 发日报，回复只生成草稿
#   single_approval  草稿需你在日报卡片/指令批准后才发出
#   whitelist_auto   白名单会话内高置信度经验直接自动回复（有每日配额硬门）
FEISHU_DEPLOYMENT_MODE=offline
FEISHU_AUTO_REPLY_ENABLED=0
FEISHU_SHADOW_MODE=1

# owner 单聊 chat_id（自迭代/通知投递用；白名单第一项即 owner 会话）
FEISHU_CHAT_WHITELIST=
FEISHU_CHAT_BLACKLIST=
FEISHU_REPLY_ALLOWED_CHATS=
FEISHU_REPLY_IDENTITY=bot
FEISHU_GROUP_REPLY_ONLY_MENTION=0

# ---- LLM（OpenAI 兼容协议：DeepSeek / 豆包 / 通义 / 智谱均可）----
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-api-key
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_TIMEOUT=30
LLM_DAILY_BUDGET_CALLS=500
LLM_MAX_CONCURRENCY=2
# 允许真实调用模型（离线测试请保持 0）
FEISHU_ALLOW_LIVE_MODEL=0

# ---- EvoHarness Agent 桥（L9049）----
# 开启后，带「问：」前缀的消息会路由到本机 EvoHarness Web 服务（需先 start_web.bat），
# 答案走标准草稿审批链；服务不可用时自动回落经验库流程。
FEISHU_EVOHARNESS_ASK_ENABLED=0
EVOHARNESS_ASK_BASE_URL=http://127.0.0.1:8800

# ---- Embedding / 匹配 ----
# 供应商不支持 embedding 就用 keyword（内置 jieba + TF-IDF，无需额外接口）
MATCHER_MODE=keyword
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# ---- 置信度策略（上游 F00/F07 冻结值，勿随意调）----
AUTO_REPLY_THRESHOLD=0.85
DRAFT_MIN_THRESHOLD=0.55
EXACT_MATCH_SCORE=0.95
EXPERIENCE_DISMISS_LIMIT=2
NEGATIVE_EXAMPLE_THRESHOLD=0.80

# ---- 自动回复硬门 ----
AUTO_REPLY_MAX_PER_CHAT_PER_DAY=3
AUTO_REPLY_ALLOWED_CATEGORIES=faq
AUTO_REPLY_START_HOUR=0
AUTO_REPLY_END_HOUR=24

# ---- 每日流水线 ----
DAILY_REPORT_TIME=08:30
DAILY_REPORT_TIMEZONE=Asia/Shanghai
DAILY_LOOKBACK_DAYS=1
FEISHU_DAILY_REPORT_ENABLED=1

# ---- 存储 ----
DATABASE_URL=sqlite:///data/agent.db
LOG_LEVEL=INFO
