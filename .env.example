# Choose a model ID offered by your provider. Never commit the filled .env.
# An OpenAI-compatible endpoint:
APIKEY=sk-your-api-key
API=https://your-provider.example/v1
MODEL=your-model-id

# Optional generic aliases supported by EvoHarness.
# EVOHARNESS_API_KEY=sk-your-api-key
# EVOHARNESS_API_BASE=https://your-provider.example/v1

# Anthropic native config.
# ANTHROPIC_API_KEY=sk-ant-your-api-key
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# OpenAI-compatible config.
# OPENAI_API_KEY=sk-your-api-key
# OPENAI_BASE_URL=https://your-openai-compatible-host/v1
# MODEL=your-model-id

# One database for Web, Worker and optional channels.
EVOHARNESS_DATABASE_URL=sqlite:///data/org.db
